+static void unix_ext_display_close(void)
+{
+    if (s_ext_texture) {
+        SDL_DestroyTexture(s_ext_texture);
+        s_ext_texture = NULL;
+    }
+    if (s_ext_renderer) {
+        SDL_DestroyRenderer(s_ext_renderer);
+        s_ext_renderer = NULL;
+    }
+    if (s_ext_window) {
+        SDL_DestroyWindow(s_ext_window);
+        s_ext_window = NULL;
+        write_log(_T("External display: closed\n"));
+    }
+    s_ext_display = 0;
+    s_ext_texture_width = s_ext_texture_height = s_ext_texture_pixbytes = 0;
+}
+
+/* First display that is neither the primary nor the one hosting the main
+ * window — i.e. the TV. */
+static SDL_DisplayID unix_ext_candidate_display(void)
+{
+    SDL_DisplayID main_display = s_window ? SDL_GetDisplayForWindow(s_window) : 0;
+    if (!main_display) {
+        main_display = SDL_GetPrimaryDisplay();
+    }
+    int count = 0;
+    SDL_DisplayID *displays = SDL_GetDisplays(&count);
+    SDL_DisplayID found = 0;
+    if (displays) {
+        for (int i = 0; i < count; i++) {
+            if (displays[i] && displays[i] != main_display) {
+                found = displays[i];
+                break;
+            }
+        }
+        SDL_free(displays);
+    }
+    return found;
+}
+
+static void unix_ext_display_open_if_available(void)
+{
+    if (!unix_video_external_enabled || s_ext_window || !s_window) {
+        return;
+    }
+    SDL_DisplayID display = unix_ext_candidate_display();
+    if (!display) {
+        return;
+    }
+    SDL_Rect bounds;
+    if (!SDL_GetDisplayBounds(display, &bounds) || bounds.w <= 0 || bounds.h <= 0) {
+        return;
+    }
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetStringProperty(props, SDL_PROP_WINDOW_CREATE_TITLE_STRING, "iPadUAE");
+    SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_X_NUMBER, SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+    SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_Y_NUMBER, SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+    SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_WIDTH_NUMBER, bounds.w);
+    SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_HEIGHT_NUMBER, bounds.h);
+    SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_FULLSCREEN_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_BORDERLESS_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_HIGH_PIXEL_DENSITY_BOOLEAN, true);
+    /* Never steal input focus from the device window. */
+    SDL_SetBooleanProperty(props, SDL_PROP_WINDOW_CREATE_FOCUSABLE_BOOLEAN, false);
+    s_ext_window = SDL_CreateWindowWithProperties(props);
+    SDL_DestroyProperties(props);
+    if (!s_ext_window) {
+        write_log(_T("External display: window creation failed: %s\n"), SDL_GetError());
+        return;
+    }
+    s_ext_renderer = SDL_CreateRenderer(s_ext_window, NULL);
+    if (!s_ext_renderer) {
+        write_log(_T("External display: renderer creation failed: %s\n"), SDL_GetError());
+        unix_ext_display_close();
+        return;
+    }
+    /* The TV must never pace the emulator; the main window handles vsync
+     * policy. */
+    SDL_SetRenderVSync(s_ext_renderer, 0);
+    SDL_SetRenderDrawColor(s_ext_renderer, 0, 0, 0, 255);
+    SDL_RenderClear(s_ext_renderer);
+    SDL_RenderPresent(s_ext_renderer);
+    s_ext_display = display;
+    write_log(_T("External display: opened %dx%d on display %u\n"),
+        bounds.w, bounds.h, (unsigned int)display);
+}
+
+static bool unix_ext_ensure_texture(int width, int height, int pixbytes)
+{
+    if (!s_ext_renderer) {
+        return false;
+    }
+    if (s_ext_texture && s_ext_texture_width == width && s_ext_texture_height == height &&
+        s_ext_texture_pixbytes == pixbytes) {
+        return true;
+    }
+    if (s_ext_texture) {
+        SDL_DestroyTexture(s_ext_texture);
+        s_ext_texture = NULL;
+    }
+    s_ext_texture = SDL_CreateTexture(s_ext_renderer, texture_format_for_pixbytes(pixbytes),
+        SDL_TEXTUREACCESS_STREAMING, width, height);
+    if (!s_ext_texture) {
+        write_log(_T("External display: texture creation failed: %s\n"), SDL_GetError());
+        return false;
+    }
+    SDL_SetTextureBlendMode(s_ext_texture, SDL_BLENDMODE_NONE);
+    s_ext_texture_width = width;
+    s_ext_texture_height = height;
+    s_ext_texture_pixbytes = pixbytes;
+    return true;
+}
+
+static void unix_ext_display_present(const struct unix_video_frame *frame,
+    const struct gfx_filterdata *filter)
+{
+    if (!s_ext_window || !s_ext_renderer ||
+        !unix_ext_ensure_texture(frame->width, frame->height, frame->pixbytes)) {
+        return;
+    }
+    SDL_SetTextureScaleMode(s_ext_texture,
+        filter && filter->gfx_filter_bilinear ? SDL_SCALEMODE_LINEAR : SDL_SCALEMODE_NEAREST);
+    SDL_UpdateTexture(s_ext_texture, NULL, frame->pixels, frame->rowbytes);
+
+    /* Plain centered aspect-fit — make_video_layout is not reusable here
+     * because it applies the *device* window's safe-area insets (iPad
+     * rounded corners), which have no meaning on a TV. */
+    int output_width = 0, output_height = 0;
+    if (!SDL_GetRenderOutputSize(s_ext_renderer, &output_width, &output_height) ||
+        output_width <= 0 || output_height <= 0) {
+        return;
+    }
+    const float sx = (float)output_width / (float)frame->width;
+    const float sy = (float)output_height / (float)frame->height;
+    const float scale = sx < sy ? sx : sy;
+    SDL_FRect dst;
+    dst.w = (float)frame->width * scale;
+    dst.h = (float)frame->height * scale;
+    dst.x = ((float)output_width - dst.w) * 0.5f;
+    dst.y = ((float)output_height - dst.h) * 0.5f;
+
+    SDL_SetRenderDrawColor(s_ext_renderer, 0, 0, 0, 255);
+    SDL_RenderClear(s_ext_renderer);
+    SDL_RenderTexture(s_ext_renderer, s_ext_texture, NULL, &dst);
+    SDL_RenderPresent(s_ext_renderer);
+}
+
+/* Runtime toggle from the app UI. */
+void unix_video_set_external_display(bool enabled)
+{
+    unix_video_external_enabled = enabled;
+    if (!enabled) {
+        unix_ext_display_close();
+    } else {
+        unix_ext_display_open_if_available();
+    }
+}
