+    }
+    /* Nothing to clear on a pristine start (app launch): keep initial-boot
+     * behaviour identical to the pre-handler code. Only reboots with live
+     * RTG state need the cleanup. */
+    bool dirty = unix_uaegfx_base || unix_picasso_boardinfo || unix_picasso_amem ||
+        unix_uaegfx_interrupt_enabled;
+    for (int monid = 0; monid < MAX_AMIGAMONITORS && !dirty; monid++) {
+        dirty = picasso96_state[monid].SwitchState != 0;
+    }
+    if (!dirty) {
