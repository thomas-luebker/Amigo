+/* Machine-reset handler, mirroring od-win32 picasso_reset(): the guest-
+ * visible P96 state (picasso96_state incl. SwitchState) and the cached
+ * guest addresses must not survive a reboot. Without this the emulator's
+ * reset (custom_reset/drawing_init) cleared picasso_on/requested_on while
+ * SwitchState stayed 1 — guest and emulator diverged and the uaegfx driver
+ * did not re-initialise, so RTG intermittently failed to come back after
+ * soft or hard reset. */
+static void unix_picasso_reset(int hardreset)
+{
+    if (isrestore()) {
+        return;
+    }
+    /* Nothing to clear on a pristine start (app launch): keep initial-boot
+     * behaviour identical to the pre-handler code. Only reboots with live
+     * RTG state need the cleanup. */
+    bool dirty = unix_uaegfx_base || unix_picasso_boardinfo || unix_picasso_amem ||
+        unix_uaegfx_interrupt_enabled;
+    for (int monid = 0; monid < MAX_AMIGAMONITORS && !dirty; monid++) {
+        dirty = picasso96_state[monid].SwitchState != 0;
+    }
+    if (!dirty) {
+        return;
+    }
+    write_log(_T("iPadUAE RTG: unix_picasso_reset(hard=%d)\n"), hardreset);
+    unix_uaegfx_base = 0;
+    unix_uaegfx_old = 0;
+    unix_picasso_amem = 0;
+    unix_picasso_amemend = 0;
+    unix_picasso_boardinfo = 0;
+    unix_uaegfx_interrupt_enabled = false;
+    for (int monid = 0; monid < MAX_AMIGAMONITORS; monid++) {
+        InitPicasso96(monid);
+    }
+}
+
 void uaegfx_install_code(uaecptr start)
 {
     unix_uaegfx_rom = start;
     org(start);
+    device_add_reset(unix_picasso_reset);
 }
 
