+/* Touchscreen input (iPadUAE): trackpad-style relative mouse driven by SDL
+ * finger events. Touch-to-mouse synthesis is disabled via the
+ * SDL_TOUCH_MOUSE_EVENTS hint so real (GCMouse) mice keep their own path.
+ * One finger drags the pointer; a quick tap clicks; a two-finger tap is a
+ * right click. Click release is deferred a few frames so the emulated
+ * Amiga's 50Hz input polling can observe the press. */
+static SDL_FingerID s_touch_primary_finger;
+static bool s_touch_primary_active = false;
+static float s_touch_last_x = 0.0f, s_touch_last_y = 0.0f;
+static Uint64 s_touch_down_ticks = 0;
+static float s_touch_travel = 0.0f;
+static int s_touch_finger_count = 0;
+static int s_touch_max_fingers = 0;
+static int s_touch_pending_click = -1;
+static Uint64 s_touch_release_at = 0;
+
+/* Second finger in 1:1 mode: undecided until it moves (scroll wheel) or
+ * rests ~170ms (RMB hold, for Intuition menus); a quick lift is an RMB
+ * click. */
+static SDL_FingerID s_touch_second_finger;
+static bool s_touch_second_active = false;
+static int s_touch_second_mode = 0;   /* 0 undecided, 1 RMB held, 2 scroll */
+static float s_touch_second_start_x, s_touch_second_start_y, s_touch_second_last_y;
+static Uint64 s_touch_second_down_ticks = 0;
+static float s_touch_scroll_accum = 0.0f;
+
+static void touch_process_pending_click(void)
+{
+    if (s_touch_pending_click >= 0 && SDL_GetTicks() >= s_touch_release_at) {
+        unix_input_mouse_button(s_touch_pending_click, false);
+        s_touch_pending_click = -1;
+    }
+    if (s_touch_second_active && s_touch_second_mode == 0 &&
+        SDL_GetTicks() - s_touch_second_down_ticks >= 170) {
+        s_touch_second_mode = 1;
+        unix_input_mouse_button(1, true);
+    }
+}
