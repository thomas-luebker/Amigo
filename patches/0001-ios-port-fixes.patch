+/* Map a window-coordinate point to emulated frame-buffer coordinates
+ * (the space mousehack's get_mouse_position expects, since the Unix
+ * getgfxoffset is identity). */
+static bool window_point_to_emulated(float wx, float wy, int *bx, int *by)
+{
+    if (!s_present_map_valid || !s_window ||
+        s_present_dst.w <= 0.0f || s_present_dst.h <= 0.0f) {
+        return false;
+    }
+    int ww = 0, wh = 0, pw = 0, ph = 0;
+    SDL_GetWindowSize(s_window, &ww, &wh);
+    SDL_GetWindowSizeInPixels(s_window, &pw, &ph);
+    float px = (ww > 0) ? wx * (float)pw / (float)ww : wx;
+    float py = (wh > 0) ? wy * (float)ph / (float)wh : wy;
+    float fx = (px - s_present_dst.x) / s_present_dst.w;
+    float fy = (py - s_present_dst.y) / s_present_dst.h;
+    if (fx < 0.0f) fx = 0.0f;
+    if (fx > 1.0f) fx = 1.0f;
+    if (fy < 0.0f) fy = 0.0f;
+    if (fy > 1.0f) fy = 1.0f;
+    *bx = (int)(s_present_src.x + fx * s_present_src.w);
+    *by = (int)(s_present_src.y + fy * s_present_src.h);
+    return true;
+}
