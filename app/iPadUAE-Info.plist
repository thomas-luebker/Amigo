<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Keys here exist because the
	     INFOPLIST_KEY_ build-setting equivalents are missing or broken in
	     Xcode 26 (UIFileSharingEnabled has no xcspec mapping and is
	     silently dropped if set as a build setting). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- SDL3 links Apple's camera / Bluetooth / microphone APIs even when
	     unused; Apple requires a purpose string for any referenced API.
	     Bluetooth is genuine (game controllers); camera/mic are unused. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>iPadUAE uses Bluetooth to connect game controllers for Amiga input.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>iPadUAE uses Bluetooth to connect game controllers for Amiga input.</string>
	<key>NSCameraUsageDescription</key>
	<string>iPadUAE does not use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>iPadUAE does not use the microphone.</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
